.program picoenc

; Experimental single-duty encoder; not selected by CMake.
; At 80 MHz: PPS LOW gives 50% duty; PPS HIGH gives 25% duty.
; Each 10 MHz period lasts eight PIO clocks.
; Configuration: JMP_PIN = PPS input; SIDESET_BASE = carrier output.
;
; Version:
; 17-Nov-2026  Marek Dorsic (.md)

.side_set 1

.wrap_target
cycle:
    jmp pin short_pulse side 1  ; Rising edge; sample PPS input

; PPS LOW: HIGH for 4 cycles, LOW for 4 cycles
    nop                side 1 [2]
    jmp cycle          side 0 [3]

; PPS HIGH: HIGH for 2 cycles, LOW for 6 cycles
short_pulse:
    nop                side 1
    jmp cycle          side 0 [5]
.wrap

; webmaster@smu.sk

